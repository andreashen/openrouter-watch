---
type Model = {
  model_id: string;
  author: string;
  slug: string;
  vendor_name: string;
  name: string;
  openrouter_model_url?: string | null;
  context_length: number | null;
  max_completion_tokens: number | null;
  input_price_usd_per_1m: number | null;
  weighted_avg_input_price_usd_per_1m?: number | null;
  output_price_usd_per_1m: number | null;
  supports_reasoning: boolean;
  supports_tools: boolean;
  supports_vision: boolean;
  intelligence_index: number | null;
  coding_index: number | null;
  agentic_index: number | null;
  knowledge_cutoff?: string | null;
  released_at?: string | null;
  officially_removed: boolean;
  fetched_at: string;
  updated_at?: string | null;
  is_pointer?: boolean;
  pointer_target_id?: string | null;
  pointer_kind?: string | null;
};

type Props = {
  models: Model[];
};

const { models } = Astro.props;
const assetBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

/** 静态锁定的主流厂商快筛名单（RFC 已确认，勿按数据动态扩缩）
 *  mono: true 表示近黑/默认黑单色 SVG，暗色模式下需 invert 才能看清。
 */
const vendorQuickFilters = [
  { name: "Anthropic", icon: "anthropic.svg", mono: true },
  { name: "OpenAI", icon: "openai.svg", mono: true },
  { name: "xAI", icon: "xai.svg", mono: true },
  { name: "Z.ai", icon: "zai.svg", mono: false },
  { name: "Google", icon: "google.png", mono: false },
  { name: "Xiaomi", icon: "xiaomi.png", mono: false },
  { name: "MoonshotAI", icon: "moonshotai.png", mono: false },
  { name: "Qwen", icon: "qwen.svg", mono: false },
  { name: "MiniMax", icon: "minimax.png", mono: false },
  { name: "DeepSeek", icon: "deepseek.svg", mono: false },
] as const;

const PRICE_UNIT_TIP = "单位：USD / 1M tokens";
/** OpenRouter Effective Pricing：按实际 Token 用量对标价输入与缓存读取价加权（见模型页 Weighted Avg Input Price） */
const WEIGHTED_INPUT_TIP =
  "单位：USD / 1M tokens；OpenRouter 按 Token 用量对输入价与缓存价加权的有效输入价";

const columns: { label: string; tip?: string }[] = [
  { label: "Model ID" },
  { label: "上下文" },
  { label: "最大输出" },
  { label: "输入价", tip: PRICE_UNIT_TIP },
  { label: "加权输入价", tip: WEIGHTED_INPUT_TIP },
  { label: "输出价", tip: PRICE_UNIT_TIP },
  { label: "Intelligence" },
  { label: "Coding" },
  { label: "Agentic" },
  { label: "能力" },
  { label: "知识截止" },
  { label: "发布日期" },
  { label: "更新时间" },
];

const capabilityFilters = [
  { id: "reasoning", label: "Reasoning", letter: "R", onClass: "cap-badge--r" },
  { id: "tools", label: "Tools", letter: "T", onClass: "cap-badge--t" },
  { id: "vision", label: "Vision", letter: "V", onClass: "cap-badge--v" },
] as const;

const rangeFields = [
  { key: "context_length", label: "上下文（k）", scale: 1000 },
  { key: "max_completion_tokens", label: "最大输出（k）", scale: 1000 },
  { key: "input_price_usd_per_1m", label: "输入价", scale: 1 },
  { key: "weighted_avg_input_price_usd_per_1m", label: "加权输入价", scale: 1 },
  { key: "output_price_usd_per_1m", label: "输出价", scale: 1 },
  { key: "intelligence_index", label: "Intelligence", scale: 1 },
  { key: "coding_index", label: "Coding", scale: 1 },
  { key: "agentic_index", label: "Agentic", scale: 1 },
];
---

<section
  class="overflow-hidden rounded-[var(--ow-radius)] border backdrop-blur-sm"
  style="border-color: var(--ow-line); background: var(--ow-surface); box-shadow: var(--ow-shadow);"
>
  <div class="flex flex-col gap-6 border-b p-6" style="border-color: var(--ow-line);">
    <div class="grid gap-6 lg:grid-cols-2">
      <div>
        <label for="model-search" class="text-sm font-semibold" style="color: var(--ow-ink);">模型搜索</label>
        <div class="relative mt-2">
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
            <svg class="h-5 w-5 opacity-45" style="color: var(--ow-ink-3);" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
            </svg>
          </div>
          <input
            id="model-search"
            type="search"
            placeholder="搜索 model_id / vendor / name / author / slug"
            class="ow-control block w-full rounded-xl border py-2.5 pl-10 pr-3 text-sm transition-colors focus:outline-none focus:ring-2"
          />
        </div>
      </div>
      <div>
        <p class="text-sm font-semibold" style="color: var(--ow-ink);">能力筛选（AND）</p>
        <div class="mt-3 flex flex-wrap gap-3 text-sm" style="color: var(--ow-ink-2);">
          {capabilityFilters.map((cap) => (
            <label class="cap-filter-item group relative flex cursor-pointer items-center gap-2 rounded-xl border px-3 py-2 transition-colors">
              <input
                id={`cap-${cap.id}`}
                type="checkbox"
                aria-label={cap.label}
                class="peer h-4 w-4 rounded border-slate-300 bg-white text-[color:var(--ow-accent)] focus:ring-[color:var(--ow-accent)]/40 dark:border-slate-600 dark:bg-slate-900"
              />
              <span
                class={`cap-badge cap-badge--on ${cap.onClass} cap-badge--legend`}
                aria-hidden="true"
              >{cap.letter}</span>
              <span>{cap.label}</span>
            </label>
          ))}
        </div>
      </div>
    </div>

    <div>
      <p class="text-sm font-semibold" style="color: var(--ow-ink);">关键数值范围（AND）</p>
      {/* Desktop: 4-col grid; label above, min/max share ow-control chrome */}
      <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {rangeFields.map((field) => (
          <div class="range-field">
            <span class="range-field-label">{field.label}</span>
            <div class="range-field-inputs">
              <input
                type="number"
                step="any"
                inputmode="decimal"
                placeholder="min"
                aria-label={`${field.label} 最小值`}
                data-range-key={field.key}
                data-range-bound="min"
                data-range-scale={field.scale}
                class="ow-control range-field-input"
              />
              <span class="range-field-sep" aria-hidden="true">–</span>
              <input
                type="number"
                step="any"
                inputmode="decimal"
                placeholder="max"
                aria-label={`${field.label} 最大值`}
                data-range-key={field.key}
                data-range-bound="max"
                data-range-scale={field.scale}
                class="ow-control range-field-input"
              />
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <div>
        <label for="sort-field" class="text-sm font-semibold" style="color: var(--ow-ink);">排序字段</label>
        <select
          id="sort-field"
          class="ow-control mt-2 block w-full rounded-xl border px-3 py-2.5 text-sm transition-colors focus:outline-none focus:ring-2"
        >
          <option value="">不排序</option>
          <option value="context_length">上下文</option>
          <option value="max_completion_tokens">最大输出</option>
          <option value="input_price_usd_per_1m">输入价</option>
          <option value="weighted_avg_input_price_usd_per_1m">加权输入价</option>
          <option value="output_price_usd_per_1m">输出价</option>
          <option value="intelligence_index">Intelligence</option>
          <option value="coding_index">Coding</option>
          <option value="agentic_index">Agentic</option>
          <option value="knowledge_cutoff">知识截止</option>
          <option value="released_at">发布日期</option>
          <option value="updated_at">更新时间</option>
        </select>
      </div>
      <div>
        <label for="sort-direction" class="text-sm font-semibold" style="color: var(--ow-ink);">排序方向</label>
        <select
          id="sort-direction"
          disabled
          class="ow-control mt-2 block w-full rounded-xl border px-3 py-2.5 text-sm transition-colors focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-50"
        >
          <option value="desc">降序</option>
          <option value="asc">升序</option>
        </select>
      </div>
      <div>
        <span class="text-sm font-semibold" style="color: var(--ow-ink);">已下架模型</span>
        <div
          id="removed-filter"
          role="radiogroup"
          aria-label="已下架模型显示方式"
          class="seg-ctrl mt-2 inline-flex w-full rounded-xl border p-0.5"
        >
          <button
            type="button"
            data-removed-filter="hide"
            aria-pressed="true"
            class="removed-filter-btn flex-1 rounded-lg px-2 py-2 text-xs font-medium transition-colors"
          >
            不显示
          </button>
          <button
            type="button"
            data-removed-filter="show"
            aria-pressed="false"
            class="removed-filter-btn flex-1 rounded-lg px-2 py-2 text-xs font-medium transition-colors"
          >
            显示
          </button>
          <button
            type="button"
            data-removed-filter="only"
            aria-pressed="false"
            class="removed-filter-btn flex-1 rounded-lg px-2 py-2 text-xs font-medium transition-colors"
          >
            只显示
          </button>
        </div>
      </div>
      <div>
        <span class="text-sm font-semibold" style="color: var(--ow-ink);">模型系列latest</span>
        <div
          id="pointer-filter"
          role="radiogroup"
          aria-label="模型系列 latest 显示方式"
          class="seg-ctrl mt-2 inline-flex w-full rounded-xl border p-0.5"
        >
          <button
            type="button"
            data-pointer-filter="hide"
            aria-pressed="true"
            class="removed-filter-btn flex-1 rounded-lg px-2 py-2 text-xs font-medium transition-colors"
          >
            不显示
          </button>
          <button
            type="button"
            data-pointer-filter="show"
            aria-pressed="false"
            class="removed-filter-btn flex-1 rounded-lg px-2 py-2 text-xs font-medium transition-colors"
          >
            显示
          </button>
          <button
            type="button"
            data-pointer-filter="only"
            aria-pressed="false"
            class="removed-filter-btn flex-1 rounded-lg px-2 py-2 text-xs font-medium transition-colors"
          >
            只显示
          </button>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap items-center gap-3">
        <p id="model-count" class="text-sm font-semibold ow-accent-text" aria-live="polite">
          共 {models.length} 个模型
        </p>
        <button
          type="button"
          id="pin-clear-all"
          class="ow-press rounded-full border px-3 py-1.5 text-xs font-semibold transition-colors disabled:cursor-not-allowed disabled:opacity-45"
          style="border-color: var(--ow-line-strong); background: var(--ow-fill-quiet); color: var(--ow-ink-2);"
          disabled
          aria-disabled="true"
        >
          清空全部 Pin
        </button>
      </div>
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="厂商快速筛选">
        {vendorQuickFilters.map((vendor) => (
          <button
            type="button"
            class="vendor-chip ow-press"
            data-vendor-filter={vendor.name}
            aria-pressed="false"
            title={vendor.name}
          >
            <img
              src={`${assetBase}vendors/${vendor.icon}`}
              alt=""
              width="28"
              height="28"
              class:list={["h-7 w-7 object-contain", vendor.mono && "vendor-icon-mono"]}
              loading="lazy"
            />
            <span class="sr-only">{vendor.name}</span>
          </button>
        ))}
        <button
          type="button"
          id="vendor-filter-clear"
          class="ow-press rounded-full border px-3 py-1.5 text-xs font-semibold transition-colors"
          style="border-color: var(--ow-line-strong); background: var(--ow-fill-quiet); color: var(--ow-ink-2);"
        >
          清除厂商
        </button>
      </div>
    </div>
  </div>

  <div class="overflow-x-auto overflow-y-auto max-h-[70vh] custom-scrollbar">
    <table id="model-table" class="min-w-max border-collapse text-left text-sm w-full">
      <thead class="sticky top-0 z-20 text-xs uppercase tracking-wider shadow-sm backdrop-blur-[16px] backdrop-saturate-150" style="background: var(--ow-chrome); color: var(--ow-ink-3);">
        <tr>
          {columns.map((column, index) => (
            index === 0 ? (
              <th
                id="model-id-col-header"
                data-col="model-id"
                class="relative whitespace-nowrap border-b px-5 py-4 font-semibold"
                style="border-color: var(--ow-line);"
              >
                <span>{column.label}</span>
                <span
                  id="model-id-col-resizer"
                  role="separator"
                  aria-orientation="vertical"
                  aria-label="调整 Model ID 列宽"
                  tabindex="0"
                  class="absolute right-0 top-0 z-30 h-full w-1.5 cursor-col-resize touch-none select-none bg-transparent focus-visible:outline-none"
                ></span>
              </th>
            ) : (
              <th class="whitespace-nowrap border-b px-5 py-4 font-semibold" style="border-color: var(--ow-line);">
                {column.tip ? (
                  <span class="inline-flex items-center gap-1.5">
                    <span>{column.label}</span>
                    <button
                      type="button"
                      class="price-unit-info"
                      data-tip={column.tip}
                      aria-label={column.tip}
                    >i</button>
                  </span>
                ) : (
                  column.label
                )}
              </th>
            )
          ))}
        </tr>
      </thead>
      <tbody id="model-table-body" class="divide-y" style="border-color: var(--ow-line);">
        {/* Rendered by JS */}
      </tbody>
    </table>
  </div>
</section>

<style>
  .ow-control {
    border: 1px solid var(--ow-line-strong);
    background: var(--ow-fill-quiet);
    color: var(--ow-ink);
  }

  .ow-control::placeholder {
    color: var(--ow-ink-3);
  }

  .ow-control:focus {
    border-color: var(--ow-accent);
    background: #fff;
    --tw-ring-color: var(--ow-accent-soft);
    box-shadow: 0 0 0 3px var(--ow-accent-soft);
  }

  :global(.dark) .ow-control:focus {
    background: #1c1c1e;
  }

  .range-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
  }

  .range-field-label {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--ow-ink-2);
  }

  .range-field-inputs {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
  }

  .range-field-sep {
    font-size: 0.8125rem;
    line-height: 1;
    color: var(--ow-ink-3);
  }

  .range-field-input {
    min-width: 0;
    width: 100%;
    border-radius: 0.75rem;
    padding: 0.625rem 0.75rem;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    transition: border-color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .range-field-input:focus {
    outline: none;
  }

  .seg-ctrl {
    border-color: var(--ow-line-strong);
    background: var(--ow-fill-quiet);
  }

  .cap-filter-item {
    border-color: var(--ow-line-strong);
    background: #fff;
  }

  :global(.dark) .cap-filter-item {
    background: #1c1c1e;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.04);
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.18);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 0, 0, 0.28);
  }

  :global(.dark) .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.04);
  }
  :global(.dark) .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
  }

  .removed-filter-btn[aria-pressed="true"] {
    background: #fff;
    color: var(--ow-accent);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }

  .removed-filter-btn[aria-pressed="false"] {
    color: var(--ow-ink-3);
  }

  :global(.dark) .removed-filter-btn[aria-pressed="true"] {
    background: rgba(255, 255, 255, 0.1);
    color: var(--ow-accent);
    box-shadow: none;
  }

  .vendor-chip {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.25rem;
    border-radius: 0.75rem;
    border: 1.5px solid var(--ow-line);
    background: #fff;
    box-shadow: none;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .vendor-chip:hover {
    border-color: rgba(0, 113, 227, 0.45);
  }

  .vendor-chip[aria-pressed="true"] {
    border-color: var(--ow-accent);
    background: #e8f1fc;
  }

  :global(.dark) .vendor-chip {
    background: #1c1c1e;
  }

  :global(.dark) .vendor-chip[aria-pressed="true"] {
    border-color: var(--ow-accent);
    background: rgba(10, 132, 255, 0.18);
  }

  /* Anthropic / OpenAI / xAI 为近黑单色标，暗色底上需反色才可见 */
  :global(.dark) .vendor-chip img.vendor-icon-mono {
    filter: invert(1);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Cells need overflow:hidden for ellipsis; header must stay visible so the
     resizer hit area (::after) is not clipped at the column boundary. */
  :global(#model-id-col-header) {
    overflow: visible;
  }

  :global(td[data-col="model-id"]) {
    overflow: hidden;
  }

  /* Fixed layout: column width comes from the header only (O(1) write while dragging). */
  :global(#model-table.model-id-col-sized) {
    table-layout: fixed;
  }

  :global(td[data-col="model-id"] .model-id-cell-inner) {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    min-width: 0;
    max-width: 100%;
  }

  :global(td[data-col="model-id"] .model-id-link-wrap) {
    min-width: 0;
    flex: 1 1 auto;
  }

  :global(td[data-col="model-id"] .model-id-link) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
  }

  /* Scheme C: ghost bookmark pin toggle */
  :global(.pin-toggle) {
    flex: 0 0 auto;
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--ow-ink-3);
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  :global(.pin-toggle:hover) {
    background: var(--ow-fill-quiet);
    border-color: var(--ow-line);
    color: var(--ow-ink-2);
  }

  :global(.pin-toggle:focus-visible) {
    outline: none;
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--ow-accent);
  }

  :global(.pin-toggle[aria-pressed="true"]) {
    background: var(--ow-accent-soft);
    border-color: transparent;
    color: var(--ow-accent);
  }

  :global(.pin-toggle svg) {
    width: 1rem;
    height: 1rem;
    display: block;
  }

  :global(.pin-drag-handle) {
    flex: 0 0 auto;
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.75rem;
    padding: 0;
    border: none;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--ow-ink-3);
    cursor: grab;
    opacity: 0.55;
    /* Pointer-only affordance: not a focusable control (RFC: no keyboard reorder). */
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
  }

  :global(.pin-drag-handle:hover) {
    opacity: 1;
    background: var(--ow-fill-quiet);
    color: var(--ow-ink-2);
  }

  :global(.pin-drag-handle:active) {
    cursor: grabbing;
  }

  :global(.pin-drag-handle svg) {
    width: 0.75rem;
    height: 1rem;
    display: block;
    pointer-events: none;
  }

  :global(tr.ow-row-pinned) {
    background: rgba(0, 113, 227, 0.04);
  }

  :global(.dark tr.ow-row-pinned) {
    background: rgba(10, 132, 255, 0.08);
  }

  :global(tr.ow-row-pinned.pin-dragging) {
    opacity: 0.55;
  }

  :global(tr.ow-row-pin-drop td) {
    box-shadow: inset 0 2px 0 var(--ow-accent);
  }

  :global(td[data-col="model-id"] .model-id-text) {
    display: block;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(td[data-col="model-id"] .model-id-badge) {
    flex-shrink: 0;
  }

  /* Hover/focus via component CSS: Tailwind `bg-[color:var(--ow-accent)]/35`
     does not emit a rule, which removed the drag affordance after scheme B. */
  #model-id-col-resizer:hover {
    background-color: color-mix(in srgb, var(--ow-accent) 35%, transparent);
  }

  #model-id-col-resizer:focus-visible {
    background-color: color-mix(in srgb, var(--ow-accent) 45%, transparent);
