---
import { existsSync, readFileSync } from "node:fs";

import modelsData from "../../../data/derived/models_latest.json";
import weightedPricesData from "../../../data/derived/weighted_prices_latest.json";
import ModelTable from "../components/ModelTable.astro";
import Base from "../layouts/Base.astro";

type ModelRecord = {
  model_id: string;
  author: string;
  slug: string;
  name: string;
  fetched_at: string;
  officially_removed: boolean;
  openrouter_model_url?: string | null;
  context_length: number | null;
  max_completion_tokens: number | null;
  input_price_usd_per_1m: number | null;
  weighted_avg_input_price_usd_per_1m?: number | null;
  output_price_usd_per_1m: number | null;
  supports_reasoning: boolean;
  supports_tools: boolean;
  supports_vision: boolean;
  intelligence_index: number | null;
  coding_index: number | null;
  agentic_index: number | null;
  updated_at?: string | null;
  vendor_name: string;
};

type WeightedPriceRecord = {
  model_id: string;
  weighted_avg_input_price_usd_per_1m?: number | null;
};

type ModelsMeta = {
  refreshed_at?: string;
};

if (!Array.isArray(modelsData) || modelsData.length === 0) {
  throw new Error("data/derived/models_latest.json must contain a non-empty array");
}

for (const [index, model] of modelsData.entries()) {
  if (!model || typeof model !== "object") {
    throw new Error(`models_latest.json row ${index} must be an object`);
  }

  const record = model as Partial<ModelRecord>;
  if (!record.vendor_name) {
    throw new Error(`models_latest.json row ${index} is missing vendor_name`);
  }
}

function readWeightedPrices(): Map<string, number | null> {
  const byId = new Map<string, number | null>();
  if (!Array.isArray(weightedPricesData)) {
    return byId;
  }
  for (const row of weightedPricesData) {
    if (!row || typeof row !== "object") {
      continue;
    }
    const record = row as WeightedPriceRecord;
    if (!record.model_id) {
      continue;
    }
    const value = record.weighted_avg_input_price_usd_per_1m;
    byId.set(
      record.model_id,
      typeof value === "number" && Number.isFinite(value) ? value : null,
    );
  }
  return byId;
}

const weightedById = readWeightedPrices();
const models = (modelsData as ModelRecord[]).map((model) => ({
  ...model,
  weighted_avg_input_price_usd_per_1m: weightedById.has(model.model_id)
    ? weightedById.get(model.model_id) ?? null
    : null,
}));
const fallbackLatestFetchedAt = models
  .map((model) => Date.parse(model.fetched_at))
  .filter((timestamp) => Number.isFinite(timestamp))
  .sort((a, b) => b - a)[0];

function readModelsMeta(): ModelsMeta | null {
  const metaUrl = new URL("../../../data/derived/models_meta.json", import.meta.url);
  if (!existsSync(metaUrl)) {
    return null;
  }

  try {
    const parsed = JSON.parse(readFileSync(metaUrl, "utf-8"));
    if (!parsed || typeof parsed !== "object") {
      return null;
    }
    return parsed as ModelsMeta;
  } catch {
    return null;
  }
}

function formatUtcLabel(timestamp: number | undefined): string {
  return timestamp
    ? new Intl.DateTimeFormat("en-CA", {
      timeZone: "UTC",
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    })
      .format(new Date(timestamp))
      .replace(",", "") + " UTC"
    : "Unknown";
}

const modelsMeta = readModelsMeta();
const refreshedAt = (() => {
  const parsedMeta = Date.parse(modelsMeta?.refreshed_at ?? "");
  if (Number.isFinite(parsedMeta)) {
    return parsedMeta;
  }
  return fallbackLatestFetchedAt;
})();
const refreshedAtLabel = formatUtcLabel(refreshedAt);
const deploymentUrl = "https://andreashen.github.io/openrouter-watch/";
const repositoryUrl = "https://github.com/andreashen/openrouter-watch";
---

<Base
  title="OpenRouter Watch"
  description="Static OpenRouter model table generated from derived model data."
>
  <main class="mx-auto flex max-w-[120rem] flex-col gap-8 px-4 py-8 sm:px-6 lg:px-8">
    <header
      class="relative overflow-hidden rounded-[var(--ow-radius)] border p-7 sm:p-8 backdrop-blur-[20px] backdrop-saturate-150"
      style="border-color: var(--ow-line); background: var(--ow-chrome); box-shadow: inset 0 1px 0 rgba(255,255,255,0.7), var(--ow-shadow);"
    >
      <div class="relative z-10">
        <div class="flex items-center justify-between gap-3">
          <p class="text-xs font-bold uppercase tracking-[0.18em] ow-accent-text">
            OpenRouter Watch
          </p>
          <button
            id="theme-toggle"
            class="ow-press inline-grid h-9 w-9 place-items-center rounded-full border transition-colors"
            style="border-color: var(--ow-line); background: var(--ow-fill-quiet); color: var(--ow-ink-3);"
            aria-label="切换主题"
          >
            <svg id="theme-icon-light" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg id="theme-icon-dark" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
        <div class="mt-4 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <h1
              class="text-4xl tracking-tight sm:text-5xl"
              style="color: var(--ow-ink); font-weight: 650; letter-spacing: -0.025em;"
            >
              openrouter 模型信息表
            </h1>
            <p class="mt-3 max-w-2xl text-base leading-relaxed" style="color: var(--ow-ink-3);">
              支持统一搜索、能力复选、数值范围筛选与关键字段排序，为您提供最前沿的 AI 模型全景数据。
            </p>
          </div>
          <div class="flex flex-col items-start gap-3 md:items-end">
            <div class="flex flex-wrap items-center gap-2 md:justify-end">
              <a
                href={deploymentUrl}
                target="_blank"
                rel="noopener noreferrer"
                title={deploymentUrl}
                class="ow-press inline-flex w-full items-center justify-center rounded-full border px-4 py-2 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ow-accent)] focus-visible:ring-offset-2 sm:min-w-[30rem] sm:w-auto"
                style="border-color: var(--ow-line-strong); background: var(--ow-fill-quiet); color: var(--ow-ink);"
                aria-label="部署站点地址（新标签页打开）"
              >
                <span class="font-mono text-xs sm:text-sm whitespace-nowrap">{deploymentUrl}</span>
              </a>
              <a
                href={repositoryUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="ow-press inline-flex items-center gap-2 rounded-full border px-3.5 py-2 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ow-accent)] focus-visible:ring-offset-2"
                style="border-color: var(--ow-line-strong); background: var(--ow-fill-quiet); color: var(--ow-ink);"
                aria-label="前往 GitHub 仓库，给项目点个 Star（新标签页打开）"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 1.5A10.5 10.5 0 0 0 1.5 12a10.5 10.5 0 0 0 7.18 9.96c.53.1.72-.23.72-.5v-1.95c-2.93.64-3.55-1.24-3.55-1.24-.48-1.2-1.17-1.52-1.17-1.52-.96-.66.08-.65.08-.65 1.06.08 1.62 1.09 1.62 1.09.94 1.62 2.47 1.15 3.07.88.1-.68.37-1.15.67-1.41-2.34-.27-4.8-1.17-4.8-5.2 0-1.15.41-2.09 1.08-2.83-.1-.27-.47-1.38.1-2.88 0 0 .89-.28 2.9 1.08a10.11 10.11 0 0 1 5.28 0c2-1.36 2.88-1.08 2.88-1.08.58 1.5.22 2.61.11 2.88.68.74 1.07 1.68 1.07 2.83 0 4.04-2.47 4.92-4.82 5.18.38.33.73.98.73 1.98v2.95c0 .28.18.6.73.5A10.5 10.5 0 0 0 22.5 12 10.5 10.5 0 0 0 12 1.5Z"></path>
                </svg>
                给项目点个 Star
              </a>
            </div>
            <div
              class="flex items-center gap-3 rounded-full border px-4 py-2.5 text-sm backdrop-blur-md"
              style="border-color: var(--ow-line); background: var(--ow-surface); color: var(--ow-ink-2);"
            >
              <div class="h-2 w-2 rounded-full bg-emerald-500 dark:bg-emerald-400"></div>
              <span>数据刷新时间：<span class="font-mono font-semibold" style="color: var(--ow-ink);">{refreshedAtLabel}</span></span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <ModelTable models={models} />

    <footer class="pb-8 text-center text-sm" style="color: var(--ow-ink-3);">
      数据来源：OpenRouter网站
    </footer>
  </main>

  <script>
    const toggleBtn = document.getElementById('theme-toggle');
    const iconLight = document.getElementById('theme-icon-light');
    const iconDark = document.getElementById('theme-icon-dark');

    function updateIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        if (iconDark) iconDark.classList.remove('hidden');
        if (iconLight) iconLight.classList.add('hidden');
      } else {
        if (iconLight) iconLight.classList.remove('hidden');
        if (iconDark) iconDark.classList.add('hidden');
      }
    }

    updateIcons();

    // Listen to theme changes from other tabs or scripts
    const observer = new MutationObserver(() => {
      updateIcons();
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    toggleBtn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      window.localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateIcons();
    });
  </script>
</Base>
